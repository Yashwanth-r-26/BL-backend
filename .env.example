# Copy to .env and fill in. Everything here has a working default except the
# API key -- the service runs with no configuration at all, falling back to the
# MOCK execution path.

# ----------------------------------------------------------------- database
POSTGRES_USER=interior
POSTGRES_PASSWORD=interior
POSTGRES_DB=interior
POSTGRES_PORT=5432

# Read by alembic/env.py and interior_ai.db.repository.make_engine.
# `postgres://` and `postgresql://` are both rewritten to the psycopg driver.
# Omit entirely to use the in-memory scene store (no persistence).
DATABASE_URL=postgresql+psycopg://interior:interior@localhost:5432/interior

# --------------------------------------------------------------------- api
API_PORT=8000

# ------------------------------------------------------------------- auth
# Signing key for the bearer tokens issued by /auth/signup and /auth/login.
#
AUTH_SECRET=

# ------------------------------------------------------- execution routing
# The capability probe detects GPU, model weights, and API reachability, then
# picks a path. These variables only override or inform that decision.

# Force a path, skipping detection entirely. Useful for reproducible tests and
# for pinning a deployment that you do not want silently changing behaviour.
# One of: LOCAL_FULL | LOCAL_LIGHT | CLOUD_API | MOCK
# FORCE_EXECUTION_PATH=MOCK

# Where the probe scans for weights. Matching is by filename substring
# (`sdxl`, `flux`, `stable-diffusion` for full; `sd15`, `lcm`, `tiny-sd` for
# light), so a renamed-but-valid checkpoint is still found.
MODEL_DIR=./models

# Skip the cloud health ping during probing. Set to 1 on serverless, where a
# cold start pays that round trip on the first request of every container.
# PROBE_SKIP_HEALTHCHECK=1

# ------------------------------------------------------------------ gemini
# Absent key => probe will not select CLOUD_API, and falls through to MOCK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_HEALTH_URL=https://generativelanguage.googleapis.com/v1beta/models

# Generic alias, checked if GEMINI_API_KEY is unset.
# CLOUD_API_KEY=
